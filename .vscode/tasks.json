{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "channel",
      "type": "pickString",
      "description": "Select the deployment channel",
      "options": ["Canary", "Production"],
      "default": "Canary"
    }
  ],
  "tasks": [
    {
      "label": "Prepare Offline Packages",
      "type": "shell",
      "command": "dotnet restore HideDetailsMod.csproj --packages ./.pkgs",
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      }
    },
    {
      "label": "Build Mod (Debug)",
      "type": "shell",
      "command": "dotnet build HideDetailsMod.csproj -c Debug -p:WorkshopChannel=Canary",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Build Mod",
      "type": "shell",
      "command": "dotnet build HideDetailsMod.csproj -p:WorkshopChannel=${input:channel}",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Build Beta DLL",
      "type": "shell",
      "command": "dotnet build ./HideDetailsMod.Beta/HideDetailsMod.Beta.csproj -p:WorkshopChannel=${input:channel}",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Publish Mod",
      "type": "shell",
      "command": "dotnet publish HideDetailsMod.csproj -c ExportRelease -p:WorkshopChannel=${input:channel}",
      "problemMatcher": ["$msCompile"],
      "dependsOn": ["Credits: Validate"]
    },
    {
      "label": "Upload Mod",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/workshop/bin/upload.ps1\" -Channel ${input:channel}",
      "options": { "cwd": "${workspaceFolder}/workshop" },
      "dependsOrder": "sequence",
      "dependsOn": ["Commit version to Github"],
      "presentation": {
        "reveal": "always",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Upload Mod (No Commit)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/workshop/bin/upload.ps1\" -Channel ${input:channel} -NoCommit",
      "options": { "cwd": "${workspaceFolder}/workshop" },
      "dependsOrder": "sequence",
      "dependsOn": ["Publish Mod"],
      "presentation": {
        "reveal": "always",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Commit version to Github",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/workshop/bin/git_tag.ps1\" -Channel ${input:channel}",
      "options": { "cwd": "${workspaceFolder}/workshop" },
      "dependsOrder": "sequence",
      "dependsOn": ["Publish Mod"],
      "presentation": {
        "reveal": "always",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Credits: Validate",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/CreditsTool.ps1 -Mode Validate -Channel ${input:channel}",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "Credits: Fix",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/CreditsTool.ps1 -Mode Fix",
      "group": "build",
      "presentation": { "reveal": "always", "focus": true, "clear": true }
    },
    {
      "label": "Credits: Add Missing Credits",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/CreditsTool.ps1 -Mode Fix -AssetsOnly",
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "Atlas: Sync Card Atlas",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/ImageGen/AtlasPacker.csproj",
        "--",
        "-c",
        "${workspaceFolder}/ImageGen/atlas_config.json"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Godot: Import",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Import-GodotImages.ps1",
        "-DoImport"
      ]
    }
  ]
}
