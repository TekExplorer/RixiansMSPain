{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Slay the Spire 2 (Debug)",
      "type": "coreclr",
      "request": "launch",
      "cwd": "${workspaceFolder}/.game",
      "program": "${workspaceFolder}/.game/SlayTheSpire2.exe",
      // "args": ["-fastmp", "host_standard"],
      // "args": ["-fastmp", "join", "-clientId", "1000"],
      // "args": ["-log", "Generic", "Debug"],
      "stopAtEntry": false,
      "preLaunchTask": "Build Mod (Debug)",
      "console": "internalConsole",
      "justMyCode": false,
      "symbolOptions": {
        "searchMicrosoftSymbolServer": true,
        "searchNuGetOrgSymbolServer": true,
        "searchPaths": ["${workspaceFolder}/.game/mods/HideDetailsMod"]
      }
    }
  ]
}
